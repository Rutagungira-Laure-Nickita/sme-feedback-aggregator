{
  "name": "@sme-feedback-aggregator/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ai-analysis": "tsx --test src/modules/ai-analysis/*.test.ts",
    "test:automation": "tsx --test src/modules/automation/*.test.ts",
    "test:integrations": "tsx --test src/modules/integrations/*.test.ts",
    "test:legal": "tsx --test src/modules/legal/*.test.ts",
    "test:seed": "tsx --test src/scripts/development-seed.test.ts",
    "test:admin": "tsx --test src/modules/platform-admin/*.test.ts",
    "test:phase25.4": "tsx --test src/modules/platform-admin/*.test.ts",
    "test:phase26": "tsx --test src/modules/business-reports/*.test.ts",
    "test:phase28": "tsx --test src/modules/feedback-categories/*.test.ts src/scripts/development-seed.test.ts",
    "phase28:reconcile": "tsx src/scripts/phase-28-reconcile-development-data.ts",
    "feedback:simulate": "tsx src/scripts/simulate-feedback-processing.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@prisma/client": "^6.12.0",
    "argon2": "^0.45.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.9.0",
    "googleapis": "^174.0.0",
    "helmet": "^7.2.0",
    "html-to-text": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.12.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
