generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  BUSINESS_OWNER
  STAFF
  CUSTOMER
}

enum PlatformAppearance {
  SYSTEM
  LIGHT
  DARK
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ExternalAuthProvider {
  GOOGLE
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum BusinessMemberRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum BusinessMembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum FeedbackPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FeedbackActivityType {
  FEEDBACK_EDITED
  FEEDBACK_DELETED
  STATUS_CHANGED
  NOTE_ADDED
  ASSIGNMENT_CHANGED
  CATEGORY_CHANGED
  PRIORITY_CHANGED
  AI_RETRY_REQUESTED
  AI_CATEGORY_APPLIED
  AI_CATEGORY_DISMISSED
}

enum FeedbackActivityActorType {
  HUMAN
  SYSTEM
}

enum FeedbackFieldStateField {
  STATUS
  PRIORITY
  CATEGORY
  ASSIGNMENT
}

enum FeedbackFieldStateSource {
  DEFAULT
  HUMAN
  AI
  AUTOMATION
  SYSTEM
}

enum AutomationRuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationRuleBranchScope {
  ALL_BRANCHES
  SELECTED_BRANCHES
}

enum AutomationRuleTrigger {
  FEEDBACK_CREATED
  AI_ANALYSIS_COMPLETED
}

enum AutomationRuleMatchMode {
  ALL
  ANY
}

enum AutomationConditionType {
  BRANCH
  CHANNEL
  RATING
  STATUS
  PRIORITY
  CATEGORY
  ASSIGNMENT_STATE
  CUSTOMER_LINK_STATE
  AI_STATUS
  SENTIMENT
  SENTIMENT_CONFIDENCE
  AI_SUGGESTED_CATEGORY
  AI_CATEGORY_CONFIDENCE
  AI_SUGGESTION_STATE
}

enum AutomationConditionOperator {
  EQUALS
  NOT_EQUALS
  IN
  GREATER_THAN_OR_EQUAL
  LESS_THAN_OR_EQUAL
  IS_EMPTY
  IS_NOT_EMPTY
}

enum AutomationActionType {
  SET_PRIORITY
  SET_CATEGORY
  ASSIGN_TO_MEMBERSHIP
  UNASSIGN
  SET_STATUS
}

enum AutomationEventStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum AutomationExecutionStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
  NOT_MATCHED
}

enum AutomationActionExecutionStatus {
  SUCCESS
  SKIPPED
  FAILED
  CONFLICTED
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum CustomerActivityType {
  CREATED
  UPDATED
  ARCHIVED
  REACTIVATED
  FEEDBACK_LINKED
  FEEDBACK_UNLINKED
}

enum FeedbackChannel {
  MANUAL
  PUBLIC_FORM
  QR_CODE
  WHATSAPP
  INSTAGRAM
  X
  GOOGLE_REVIEW
  EMAIL
  FACEBOOK
  OTHER
}

enum FeedbackIngestionStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum FeedbackAIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum FeedbackAISentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
}

enum IntegrationProvider {
  GOOGLE_REVIEWS
  WHATSAPP
  EMAIL
  X
  FACEBOOK
  INSTAGRAM
}

enum IntegrationMode {
  DEMO
  LIVE
}

enum IntegrationConnectionStatus {
  CONNECTED
  PAUSED
  DISCONNECTED
  ERROR
}

enum IntegrationDemoScenario {
  STANDARD_MIXED
  PARTIAL_FAILURE
}

enum EmailProviderType {
  GMAIL
  MICROSOFT
  IMAP
}

enum IntegrationCredentialType {
  OAUTH2
  IMAP_PASSWORD
  META_WHATSAPP
}

enum IntegrationOAuthAction {
  CONNECT
  REAUTHORIZE
}

enum SynchronizationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum SynchronizationTriggerType {
  MANUAL
  WEBHOOK
}

enum SynchronizationItemStatus {
  IMPORTED
  DUPLICATE
  SKIPPED
  FAILED
}

enum IntegrationWebhookDeliveryStatus {
  RECEIVED
  IMPORTED
  DUPLICATE
  SKIPPED
  FAILED
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique @db.VarChar(255)
  passwordHash    String?       @map("password_hash") @db.VarChar(255)
  firstName       String        @map("first_name") @db.VarChar(100)
  lastName        String        @map("last_name") @db.VarChar(100)
  role            UserRole
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  lastLoginAt     DateTime?     @map("last_login_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  sessions                 Session[]
  externalAccounts         ExternalAccount[]
  accountTokens            AccountToken[]
  createdBusinesses        Business[]              @relation("BusinessCreatedBy")
  businessMemberships      BusinessMembership[]    @relation("BusinessMembershipUser")
  invitedMemberships       BusinessMembership[]    @relation("BusinessMembershipInvitedBy")
  sentStaffInvitations     StaffInvitation[]       @relation("StaffInvitationInvitedBy")
  acceptedStaffInvitations StaffInvitation[]       @relation("StaffInvitationAcceptedBy")
  integrationOAuthStates   IntegrationOAuthState[]
  platformAdminActivities  PlatformAdminActivity[] @relation("PlatformAdminActivityActor")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Business {
  id                           String         @id @default(cuid())
  name                         String         @db.VarChar(160)
  industry                     String         @db.VarChar(120)
  description                  String?        @db.Text
  email                        String         @db.VarChar(255)
  phone                        String         @db.VarChar(40)
  website                      String?        @db.VarChar(1024)
  logoUrl                      String?        @map("logo_url") @db.VarChar(1024)
  country                      String         @db.VarChar(100)
  city                         String         @db.VarChar(100)
  district                     String?        @db.VarChar(100)
  addressLine                  String         @map("address_line") @db.VarChar(255)
  timezone                     String         @db.VarChar(80)
  status                       BusinessStatus @default(PENDING)
  createdByUserId              String         @map("created_by_user_id")
  publicFeedbackEnabled        Boolean        @default(false) @map("public_feedback_enabled")
  publicFeedbackToken          String?        @unique @map("public_feedback_token") @db.VarChar(96)
  publicFeedbackWelcomeMessage String?        @map("public_feedback_welcome_message") @db.VarChar(500)
  createdAt                    DateTime       @default(now()) @map("created_at")
  updatedAt                    DateTime       @updatedAt @map("updated_at")

  createdBy              User                         @relation("BusinessCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  branches               Branch[]
  memberships            BusinessMembership[]
  invitations            StaffInvitation[]
  feedbackIngestions     FeedbackIngestion[]
  feedbacks              Feedback[]
  publicFeedbackQrCodes  PublicFeedbackQrCode[]
  feedbackActivities     FeedbackActivity[]
  feedbackCategories     FeedbackCategory[]
  feedbackAIAnalyses     FeedbackAIAnalysis[]
  customers              Customer[]
  customerActivities     CustomerActivity[]
  automationRules        AutomationRule[]
  automationEvents       AutomationEvent[]
  automationExecutions   AutomationExecution[]
  feedbackFieldStates    FeedbackFieldState[]
  integrationConnections IntegrationConnection[]
  integrationOAuthStates IntegrationOAuthState[]
  synchronizationRuns    SynchronizationRun[]
  webhookDeliveries      IntegrationWebhookDelivery[]

  @@index([status])
  @@index([publicFeedbackEnabled])
  @@index([createdByUserId])
  @@map("businesses")
}

model Branch {
  id          String       @id @default(cuid())
  businessId  String       @map("business_id")
  name        String       @db.VarChar(140)
  code        String       @db.VarChar(32)
  addressLine String       @map("address_line") @db.VarChar(255)
  city        String       @db.VarChar(100)
  district    String?      @db.VarChar(100)
  country     String       @db.VarChar(100)
  phone       String?      @db.VarChar(40)
  email       String?      @db.VarChar(255)
  isPrimary   Boolean      @default(false) @map("is_primary")
  status      BranchStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  business               Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membershipAccess       MembershipBranchAccess[]
  invitationBranches     StaffInvitationBranch[]
  feedbackIngestions     FeedbackIngestion[]
  feedbacks              Feedback[]
  publicFeedbackQrCodes  PublicFeedbackQrCode[]
  automationRuleBranches AutomationRuleBranch[]
  automationConditions   AutomationCondition[]
  integrationConnections IntegrationConnection[]
  integrationOAuthStates IntegrationOAuthState[]

  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([status])
  @@map("branches")
}

model BusinessMembership {
  id                String                   @id @default(cuid())
  businessId        String                   @map("business_id")
  userId            String                   @map("user_id")
  role              BusinessMemberRole
  status            BusinessMembershipStatus @default(ACTIVE)
  allBranchesAccess Boolean                  @default(false) @map("all_branches_access")
  invitedByUserId   String?                  @map("invited_by_user_id")
  joinedAt          DateTime?                @map("joined_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  business                      Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                          User                     @relation("BusinessMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy                     User?                    @relation("BusinessMembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  branchAccess                  MembershipBranchAccess[]
  createdPublicFeedbackQrCodes  PublicFeedbackQrCode[]
  feedbackActivities            FeedbackActivity[]
  assignedFeedbacks             Feedback[]               @relation("FeedbackAssignedTo")
  createdCustomers              Customer[]               @relation("CustomerCreatedByMembership")
  updatedCustomers              Customer[]               @relation("CustomerUpdatedByMembership")
  customerActivities            CustomerActivity[]
  createdAutomationRules        AutomationRule[]         @relation("AutomationRuleCreatedByMembership")
  updatedAutomationRules        AutomationRule[]         @relation("AutomationRuleUpdatedByMembership")
  automationActionTargets       AutomationAction[]
  feedbackFieldStatesUpdated    FeedbackFieldState[]
  deletedFeedbacks              Feedback[]               @relation("FeedbackDeletedByMembership")
  createdIntegrationConnections IntegrationConnection[]  @relation("IntegrationConnectionCreatedByMembership")
  updatedIntegrationConnections IntegrationConnection[]  @relation("IntegrationConnectionUpdatedByMembership")
  integrationOAuthStates        IntegrationOAuthState[]
  startedSynchronizationRuns    SynchronizationRun[]     @relation("SynchronizationRunStartedByMembership")

  @@unique([businessId, userId])
  @@index([businessId, status])
  @@index([userId, status])
  @@index([status])
  @@map("business_memberships")
}

model MembershipBranchAccess {
  membershipId String   @map("membership_id")
  branchId     String   @map("branch_id")
  createdAt    DateTime @default(now()) @map("created_at")

  membership BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId])
  @@map("membership_branch_access")
}

model PublicFeedbackQrCode {
  id                     String   @id @default(cuid())
  businessId             String   @map("business_id")
  branchId               String?  @map("branch_id")
  name                   String   @db.VarChar(120)
  publicToken            String   @unique @map("public_token") @db.VarChar(96)
  portalTokenFingerprint String   @map("portal_token_fingerprint") @db.VarChar(64)
  isActive               Boolean  @default(true) @map("is_active")
  createdByMembershipId  String?  @map("created_by_membership_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByMembership BusinessMembership? @relation(fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([businessId, isActive])
  @@index([businessId, branchId])
  @@index([branchId])
  @@index([createdByMembershipId])
  @@map("public_feedback_qr_codes")
}

model StaffInvitation {
  id                String                @id @default(cuid())
  businessId        String                @map("business_id")
  invitedEmail      String                @map("invited_email") @db.VarChar(255)
  role              BusinessMemberRole
  status            StaffInvitationStatus @default(PENDING)
  allBranchesAccess Boolean               @default(false) @map("all_branches_access")
  tokenHash         String                @unique @map("token_hash") @db.VarChar(64)
  expiresAt         DateTime              @map("expires_at")
  invitedByUserId   String                @map("invited_by_user_id")
  acceptedByUserId  String?               @map("accepted_by_user_id")
  acceptedAt        DateTime?             @map("accepted_at")
  cancelledAt       DateTime?             @map("cancelled_at")
  lastSentAt        DateTime?             @map("last_sent_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy    User                    @relation("StaffInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   User?                   @relation("StaffInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  branchAccess StaffInvitationBranch[]

  @@index([businessId, status])
  @@index([invitedEmail])
  @@index([status])
  @@index([expiresAt])
  @@map("staff_invitations")
}

model StaffInvitationBranch {
  invitationId String @map("invitation_id")
  branchId     String @map("branch_id")

  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([invitationId, branchId])
  @@index([branchId])
  @@map("staff_invitation_branches")
}

model FeedbackIngestion {
  id                String                  @id @default(cuid())
  businessId        String                  @map("business_id")
  branchId          String                  @map("branch_id")
  channel           FeedbackChannel
  externalId        String?                 @map("external_id") @db.VarChar(255)
  idempotencyKey    String                  @map("idempotency_key") @db.VarChar(255)
  payloadHash       String                  @map("payload_hash") @db.VarChar(64)
  status            FeedbackIngestionStatus @default(PROCESSING)
  processingVersion String                  @default("phase4-v1") @map("processing_version") @db.VarChar(40)
  errorCode         String?                 @map("error_code") @db.VarChar(80)
  errorMessage      String?                 @map("error_message") @db.VarChar(500)
  startedAt         DateTime                @default(now()) @map("started_at")
  completedAt       DateTime?               @map("completed_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch               Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  feedback             Feedback?
  synchronizationItems SynchronizationItem[]

  @@unique([businessId, channel, idempotencyKey])
  @@unique([businessId, channel, externalId])
  @@index([status])
  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("feedback_ingestions")
}

model Feedback {
  id                     String           @id @default(cuid())
  businessId             String           @map("business_id")
  branchId               String           @map("branch_id")
  ingestionId            String           @unique @map("ingestion_id")
  channel                FeedbackChannel
  externalId             String?          @map("external_id") @db.VarChar(255)
  title                  String?          @db.VarChar(250)
  message                String           @db.Text
  rating                 Int?
  status                 FeedbackStatus   @default(NEW)
  priority               FeedbackPriority @default(NORMAL)
  assignedToMembershipId String?          @map("assigned_to_membership_id")
  categoryId             String?          @map("category_id")
  customerId             String?          @map("customer_id")
  customerName           String?          @map("customer_name") @db.VarChar(160)
  customerEmail          String?          @map("customer_email") @db.VarChar(255)
  customerPhone          String?          @map("customer_phone") @db.VarChar(40)
  sourceUrl              String?          @map("source_url") @db.VarChar(1024)
  languageCode           String?          @map("language_code") @db.VarChar(20)
  occurredAt             DateTime?        @map("occurred_at")
  receivedAt             DateTime         @default(now()) @map("received_at")
  sourceMetadata         Json?            @map("source_metadata")
  deletedAt              DateTime?        @map("deleted_at")
  deletedByMembershipId  String?          @map("deleted_by_membership_id")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch               Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingestion            FeedbackIngestion     @relation(fields: [ingestionId], references: [id], onDelete: Restrict)
  attachments          FeedbackAttachment[]
  activities           FeedbackActivity[]
  aiAnalysis           FeedbackAIAnalysis?
  assignedTo           BusinessMembership?   @relation("FeedbackAssignedTo", fields: [assignedToMembershipId], references: [id], onDelete: SetNull)
  category             FeedbackCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerActivities   CustomerActivity[]
  automationEvents     AutomationEvent[]
  automationExecutions AutomationExecution[]
  fieldStates          FeedbackFieldState[]
  synchronizationItems SynchronizationItem[]
  deletedBy            BusinessMembership?   @relation("FeedbackDeletedByMembership", fields: [deletedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([businessId, channel, externalId])
  @@index([businessId, receivedAt])
  @@index([branchId, receivedAt])
  @@index([channel])
  @@index([status])
  @@index([priority])
  @@index([assignedToMembershipId])
  @@index([categoryId])
  @@index([customerId, receivedAt])
  @@index([businessId, deletedAt, receivedAt])
  @@index([deletedByMembershipId])
  @@map("feedback")
}

model FeedbackActivity {
  id                 String                    @id @default(cuid())
  businessId         String                    @map("business_id")
  feedbackId         String                    @map("feedback_id")
  actorMembershipId  String?                   @map("actor_membership_id")
  actorType          FeedbackActivityActorType @default(HUMAN) @map("actor_type")
  automationRuleId   String?                   @map("automation_rule_id")
  automationRuleName String?                   @map("automation_rule_name") @db.VarChar(120)
  type               FeedbackActivityType
  fromStatus         FeedbackStatus?
  toStatus           FeedbackStatus?
  fromValue          String?                   @map("from_value") @db.VarChar(255)
  toValue            String?                   @map("to_value") @db.VarChar(255)
  note               String?                   @db.Text
  createdAt          DateTime                  @default(now()) @map("created_at")

  feedback       Feedback            @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor          BusinessMembership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  automationRule AutomationRule?     @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)

  @@index([feedbackId, createdAt])
  @@index([businessId, createdAt])
  @@index([automationRuleId])
  @@map("feedback_activities")
}

model FeedbackFieldState {
  id                    String                   @id @default(cuid())
  businessId            String                   @map("business_id")
  feedbackId            String                   @map("feedback_id")
  field                 FeedbackFieldStateField
  source                FeedbackFieldStateSource @default(SYSTEM)
  sourceRuleId          String?                  @map("source_rule_id")
  updatedByMembershipId String?                  @map("updated_by_membership_id")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  feedback            Feedback            @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  sourceRule          AutomationRule?     @relation(fields: [sourceRuleId], references: [id], onDelete: SetNull)
  updatedByMembership BusinessMembership? @relation(fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([feedbackId, field])
  @@index([businessId, field])
  @@index([sourceRuleId])
  @@index([updatedByMembershipId])
  @@map("feedback_field_states")
}

model AutomationRule {
  id                       String                    @id @default(cuid())
  businessId               String                    @map("business_id")
  name                     String                    @db.VarChar(120)
  description              String?                   @db.VarChar(500)
  status                   AutomationRuleStatus      @default(DRAFT)
  branchScope              AutomationRuleBranchScope @default(ALL_BRANCHES) @map("branch_scope")
  trigger                  AutomationRuleTrigger
  matchMode                AutomationRuleMatchMode   @default(ALL) @map("match_mode")
  stopProcessingAfterMatch Boolean                   @default(false) @map("stop_processing_after_match")
  position                 Int
  version                  Int                       @default(1)
  createdByMembershipId    String?                   @map("created_by_membership_id")
  updatedByMembershipId    String?                   @map("updated_by_membership_id")
  archivedAt               DateTime?                 @map("archived_at")
  lastTriggeredAt          DateTime?                 @map("last_triggered_at")
  executionCount           Int                       @default(0) @map("execution_count")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  business            Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByMembership BusinessMembership?    @relation("AutomationRuleCreatedByMembership", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  updatedByMembership BusinessMembership?    @relation("AutomationRuleUpdatedByMembership", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)
  branches            AutomationRuleBranch[]
  conditions          AutomationCondition[]
  actions             AutomationAction[]
  executions          AutomationExecution[]
  activities          FeedbackActivity[]
  fieldStates         FeedbackFieldState[]

  @@index([businessId, status, trigger, position])
  @@index([businessId, status])
  @@index([createdByMembershipId])
  @@index([updatedByMembershipId])
  @@map("automation_rules")
}

model AutomationRuleBranch {
  ruleId   String @map("rule_id")
  branchId String @map("branch_id")

  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([ruleId, branchId])
  @@index([branchId])
  @@map("automation_rule_branches")
}

model AutomationCondition {
  id          String                      @id @default(cuid())
  ruleId      String                      @map("rule_id")
  type        AutomationConditionType
  operator    AutomationConditionOperator
  position    Int
  valueString String?                     @map("value_string") @db.VarChar(255)
  valueNumber Float?                      @map("value_number")
  valueJson   Json?                       @map("value_json")
  branchId    String?                     @map("branch_id")
  categoryId  String?                     @map("category_id")

  rule     AutomationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  branch   Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category FeedbackCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([ruleId, position])
  @@index([branchId])
  @@index([categoryId])
  @@map("automation_conditions")
}

model AutomationAction {
  id                 String               @id @default(cuid())
  ruleId             String               @map("rule_id")
  type               AutomationActionType
  position           Int
  valueString        String?              @map("value_string") @db.VarChar(255)
  categoryId         String?              @map("category_id")
  targetMembershipId String?              @map("target_membership_id")

  rule             AutomationRule              @relation(fields: [ruleId], references: [id], onDelete: Cascade)
