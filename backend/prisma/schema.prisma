  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model ExternalAccount {
  id                String               @id @default(cuid())
  userId            String               @map("user_id")
  provider          ExternalAuthProvider
  providerAccountId String               @map("provider_account_id") @db.VarChar(255)
  providerEmail     String?              @map("provider_email") @db.VarChar(255)
  displayName       String?              @map("display_name") @db.VarChar(255)
  avatarUrl         String?              @map("avatar_url") @db.VarChar(1024)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  lastUsedAt        DateTime?            @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("external_accounts")
}

model PlatformSettings {
  id                     String             @id @default("platform") @db.VarChar(32)
  platformName           String             @default("SME Feedback Aggregator") @map("platform_name") @db.VarChar(80)
  brandTagline           String             @default("Multi-channel intelligence") @map("brand_tagline") @db.VarChar(120)
  headline               String             @default("Turn customer feedback into business growth") @db.VarChar(180)
  platformDescription    String             @default("A secure multi-channel feedback workspace for growing businesses.") @map("platform_description") @db.VarChar(500)
  heroSupportingText     String             @default("Bring every customer voice into one clear workspace, understand what matters, and act with confidence.") @map("hero_supporting_text") @db.VarChar(320)
  primaryCtaLabel        String             @default("Get started") @map("primary_cta_label") @db.VarChar(60)
  secondaryCtaLabel      String             @default("See how it works") @map("secondary_cta_label") @db.VarChar(60)
  logoUrl                String?            @map("logo_url") @db.VarChar(2048)
  primaryColor           String             @default("#4F46E5") @map("primary_color") @db.Char(7)
  accentColor            String             @default("#818CF8") @map("accent_color") @db.Char(7)
  defaultAppearance      PlatformAppearance @default(SYSTEM) @map("default_appearance")
  supportEmail           String             @default("support@example.com") @map("support_email") @db.VarChar(255)
  supportPhone           String?            @map("support_phone") @db.VarChar(40)
  defaultReportRangeDays Int                @default(30) @map("default_report_range_days")
  reportFooterText       String             @default("Confidential platform report") @map("report_footer_text") @db.VarChar(180)
  footerText             String             @default("Copyright 2026 SME Feedback Aggregator. All rights reserved.") @map("footer_text") @db.VarChar(180)
  updatedByUserId        String?            @map("updated_by_user_id") @db.VarChar(191)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model PlatformAdminActivity {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  action      String   @db.VarChar(80)
  targetType  String   @map("target_type") @db.VarChar(40)
  targetId    String?  @map("target_id") @db.VarChar(191)
  summary     String   @db.VarChar(240)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation("PlatformAdminActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("platform_admin_activities")
}
